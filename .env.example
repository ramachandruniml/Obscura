# ---------------------------------------------------------------------------
# Obscura configuration. Copy to `.env` and adjust. Every value here is read
# by backend/app/config.py (pydantic-settings). Nothing downstream hardcodes.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
OBSCURA_ENV=dev                       # dev | prod
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                        # true -> JSON logs, false -> console

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Only used when the frontend is NOT behind the compose nginx proxy
# (e.g. local `npm run dev`). Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false        # true -> run jobs inline (no broker; tests)

# --- Storage / retention -------------------------------------------------------
STORAGE_DIR=/data                     # container path backed by the obscura-data volume
RESULT_TTL_SECONDS=3600               # inputs + outputs auto-deleted after this
CLEANUP_INTERVAL_SECONDS=300          # how often the beat task sweeps STORAGE_DIR

# --- Upload limits (adjustable) ---------------------------------------------
MAX_UPLOAD_BYTES=104857600            # 100 MiB
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
MAX_VIDEO_DURATION_SECONDS=300
MAX_IMAGE_PIXELS=50000000             # decompression-bomb guard

# --- Pipeline / output ------------------------------------------------------
DELETE_INPUT_ON_SUCCESS=true          # delete the upload once the job completes ok
VIDEO_OUTPUT_CODEC=libx264
VIDEO_OUTPUT_CRF=23
VIDEO_OUTPUT_PIX_FMT=yuv420p

# --- Detection -------------------------------------------------------------
DETECTOR_BACKEND=retinaface           # retinaface | yolov8face
DETECTOR_RUNTIME=pytorch              # pytorch | onnx (onnx: Deliverable 7)
DEVICE=cpu                            # cpu | cuda  (cuda needs docker-compose.gpu.yml)
RETINAFACE_WEIGHTS=weights/retinaface_mobilenet0.25.pth
RETINAFACE_BACKBONE=mobile0.25        # mobile0.25 | resnet50
RETINAFACE_INPUT_SIZE=640             # long side is resized to this before inference
RETINAFACE_MAX_SIDE=2048             # hard cap on the long side after resize
RETINAFACE_TOP_K=5000                # max boxes kept before NMS
RETINAFACE_KEEP_TOP_K=750            # max boxes kept after NMS
YOLOV8_FACE_WEIGHTS=weights/yolov8n-face.pt
YOLOV8_INPUT_SIZE=640
ONNX_MODEL_PATH=weights/detector.onnx   # produced by scripts/export_onnx.py (YOLOv8-face)
ONNX_OPSET=12
DEFAULT_CONFIDENCE=0.5
NMS_IOU=0.4
MAX_FACES=500

# --- Redaction ----------------------------------------------------------------
DEFAULT_REDACTION=blur                # blur | pixelate | box
BOX_PADDING_RATIO=0.15                # fraction of box size added on every side
BLUR_KERNEL_FRACTION=0.25             # gaussian kernel as fraction of box short side
BLUR_MIN_KERNEL=15                    # lower bound on the gaussian kernel (odd, px)
BLUR_PASSES=2                         # repeated blur passes for irreversibility
PIXELATE_BLOCKS=12                    # mosaic blocks across the box short side
SOLID_BOX_COLOR=0,0,0                 # BGR fill for the "box" method

# --- Video tracking (ByteTrack) --------------------------------------------
DETECT_EVERY_N_FRAMES=5               # run the detector every Nth frame, track the rest
TRACK_ACTIVATION_THRESHOLD=0.25
MIN_MATCHING_THRESHOLD=0.8
TRACK_BUFFER_FRAMES=30                # frames a lost track survives before being dropped
TRACK_LOST_PADDING_RATIO=0.30         # extra padding on coasted (un-redetected) boxes
TRACK_FPS_DEFAULT=30                  # frame rate handed to ByteTrack when a video's is unknown
TRACK_MAX_COAST_FRAMES=0             # consecutive coast frames before a track is dropped; 0 = auto
